<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Bar with Back Button and Title -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backToHubBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back_to_hub"
                android:src="@android:drawable/ic_media_previous" />

            <!-- Title Text -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_a_category"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true" />

        </RelativeLayout>

        <!-- Expense Name Input -->
        <EditText
            android:id="@+id/categoryNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name_of_your_expense_category"
            android:background="#F5EFFF"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- File Upload Button -->
        <Button
            android:id="@+id/uploadImageBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/upload_an_image_of_your_category"
            android:backgroundTint="#7B5CC4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Preview Section -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/set_monthly_total_budget_goal"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/minLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_border"
                android:hint="@string/min"
                android:inputType="numberDecimal"
                android:padding="12dp" />

            <EditText
                android:id="@+id/maxLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_border"
                android:hint="@string/max"
                android:inputType="numberDecimal"
                android:padding="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/categoryPreviewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/categoryPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="@string/category_preview_image"
            android:scaleType="centerInside"
            android:background="#DDDDDD"
            android:layout_marginBottom="32dp" />

        <!-- Done Button -->
        <Button
            android:id="@+id/doneButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#D9C8FF"
            android:text="@string/done"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>