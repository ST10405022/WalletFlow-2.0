<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Back button to return to Hub -->
    <ImageButton
        android:id="@+id/backToHubBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back_to_hub"
        android:src="@android:drawable/ic_media_previous"
        tools:ignore="TouchTargetSizeCheck" />

    <!-- Date Selection Buttons (AndroidDevelopers, 2021) -->
    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" >

        <!-- Buttons for selecting start, end dates and applying the filter (AndroidDevelopers, 2021) -->
        <ImageButton
            android:id="@+id/buttonClearFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent"
            android:contentDescription="Clear Start Date"
            android:visibility="gone" />

        <Button
            android:id="@+id/selectStartDateBtn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_start_date" />

        <Button
            android:id="@+id/selectEndDateBtn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_end_date"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/applyDateFilterBtn"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apply_filter"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- RecyclerView for displaying expenses (AndroidDevelopers, 2021) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/expenseRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="14dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/backToHubBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</LinearLayout>

<!-- Reference List
        AndroidDevelopers, 2021. Create dynamic lists with RecyclerView. [Online]
        Available at: https://developer.android.com/develop/ui/views/layout/recyclerview
        [Accessed 20 April 2025].
-->