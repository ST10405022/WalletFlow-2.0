<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backToHubBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back to Hub"
                android:src="@android:drawable/ic_media_previous" />

            <!-- Page Title -->
            <TextView
                android:id="@+id/categoryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Placeholder Image -->
        <ImageView
            android:id="@+id/categoryImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/ic_launcher_background"
            android:scaleType="centerInside"
            android:background="#E0E0E0"
            android:elevation="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Budget Goal Section (Non-editable values) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/txtMinLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Min limit:"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/inputMinValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtMaxLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Max limit:"
                android:textSize="18sp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/inputMaxValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- RecyclerView for Expense List // (Android, 2025) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Update Button -->
        <Button
            android:id="@+id/updateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:backgroundTint="#7B5CC4"
            android:textColor="#FFFFFF"
            android:elevation="4dp"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>

