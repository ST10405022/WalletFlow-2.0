<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar with Back Button and Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/backToHubBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentDescription="Back to hub"
                android:src="@android:drawable/ic_media_previous"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- Page Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add an Expense"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true" />
        </RelativeLayout>

        <!-- Expense Name -->
        <EditText
            android:id="@+id/inputExpenseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name of your expense"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Expense Amount -->
        <EditText
            android:id="@+id/inputAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select the cost amount of your expense"
            android:inputType="numberDecimal"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Date (Recurring/Once-off) -->
        <EditText
            android:id="@+id/inputDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select the date of expense"
            android:inputType="datetime"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- CheckBox for Recurring Expense -->
        <CheckBox
            android:id="@+id/recurringExpenseCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Is this a recurring expense?"
            android:layout_marginBottom="16dp"/>

        <!-- Input for Start Date (only visible if recurring) -->
        <EditText
            android:id="@+id/inputStartDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Insert Start Date"
            android:inputType="datetime"
            android:visibility="gone"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Input for End Date (only visible if recurring) -->
        <EditText
            android:id="@+id/inputEndDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Insert End Date"
            android:inputType="datetime"
            android:visibility="gone"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Description -->
        <EditText
            android:id="@+id/inputDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Create a description for your expense"
            android:background="@drawable/edittext_border"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Category Dropdown -->
        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edittext_border"
            android:minHeight="48dp"
            android:padding="12dp" />

        <!-- Upload Image Button -->
        <Button
            android:id="@+id/uploadReceiptBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload an image of your choice"
            android:backgroundTint="#7B5CC4"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp" />

        <!-- Preview Image -->
        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="Image Preview"
            android:visibility="gone" />

        <!-- Create Expense Button -->
        <Button
            android:id="@+id/createExpenseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Expense"
            android:backgroundTint="#7B5CC4"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>